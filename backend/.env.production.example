# Produção: tasks.grupoautoma.com
NODE_ENV="production"
DATABASE_URL=""
APP_ORIGIN="https://tasks.grupoautoma.com"
TRUSTED_PROXY_HEADER="x-forwarded-for"
PORT="4000"

# Redis compartilhado (obrigatório em produção). Para Redis local em Docker:
# REDIS_URL="redis://default:SENHA@127.0.0.1:6380"
REDIS_URL=""
# Alternativas REST gerenciadas:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Alternativa ao Upstash; use somente um dos pares.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Google Login, Calendar e Meet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tasks.grupoautoma.com/api/auth/google/callback"
GOOGLE_CALENDAR_REDIRECT_URI="https://tasks.grupoautoma.com/api/integrations/google-calendar/callback"
# openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# IA.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# GitHub App.
GITHUB_APP_ID=""
GITHUB_APP_SLUG="automa-tasks"
GITHUB_APP_PRIVATE_KEY_BASE64=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_SETUP_URL="https://tasks.grupoautoma.com/api/integrations/github/setup"
GITHUB_OAUTH_CALLBACK_URL="https://tasks.grupoautoma.com/api/integrations/github/oauth-callback"
# openssl rand -hex 32 — copie o mesmo valor para Webhook secret no GitHub App.
GITHUB_WEBHOOK_SECRET=""

# Web Push. Gere com: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@grupoautoma.com"

# Chaves distintas e permanentes: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=""
VAULT_ENCRYPTION_KEY=""
CONTENT_ENCRYPTION_KEY=""
