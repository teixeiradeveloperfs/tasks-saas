# Banco de desenvolvimento. Sobe com `docker compose up -d`.
# Porta 5433 e não 5432: a máquina de desenvolvimento tem um PostgreSQL nativo na padrão.
NODE_ENV="development"

DATABASE_URL="postgresql://flow:flow_dev_local@localhost:5433/flow_dev?schema=public"

# Banco usado pelos testes. É truncado entre casos — nunca aponte para o de desenvolvimento.
TEST_DATABASE_URL="postgresql://flow:flow_dev_local@localhost:5433/flow_test?schema=public"

# Origem pública do frontend. Usada pelo CORS e pela verificação de CSRF.
# Em desenvolvimento o navegador fala com a API pelo proxy do Vite, então a origem
# que chega aqui é a do frontend.
APP_ORIGIN="http://localhost:5173"

# Header que o proxy confiável usa para encaminhar o IP real do cliente.
# Em desenvolvimento, deixe vazio. Em produção, use por exemplo x-forwarded-for.
TRUSTED_PROXY_HEADER=""

# Porta HTTP da API.
PORT="4000"

# Opcional em desenvolvimento; obrigatório em produção (ou use Upstash/KV REST).
REDIS_URL=""

# Login/cadastro pelo Google. O redirect deve ser cadastrado exatamente igual no Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Calendar + Meet por usuário. Por padrão o callback usa APP_ORIGIN + o caminho abaixo
# e a criptografia deriva uma chave isolada do client secret. Os overrides permitem
# URLs distintas por ambiente e rotação independente da chave em produção.
GOOGLE_CALENDAR_REDIRECT_URI=""
# Gere com: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Assistente de IA para Runbooks e tarefas. A chave existe somente no backend.
# O modelo é configurável; o padrão do código prioriza custo e latência.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# GitHub App por workspace. Cadastre no GitHub a Setup URL como
# APP_ORIGIN/api/integrations/github/setup e a Callback URL como
# APP_ORIGIN/api/integrations/github/oauth-callback. A chave PEM deve ser
# convertida com: base64 < sua-app.private-key.pem | tr -d '\n'
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY_BASE64=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_SETUP_URL=""
GITHUB_OAUTH_CALLBACK_URL=""
# Gere um segredo aleatório e use o mesmo valor na configuração do webhook no GitHub.
GITHUB_WEBHOOK_SECRET=""

# Web Push / PWA. Gere uma vez com `bunx web-push generate-vapid-keys` e mantenha
# o mesmo par em todas as instâncias. VAPID_SUBJECT deve ser mailto: ou uma URL HTTPS.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com"

# Chaves distintas de 32 bytes em base64. Gere cada uma com:
# `openssl rand -base64 32`. Nunca altere depois que houver dados criptografados.
TWO_FACTOR_ENCRYPTION_KEY=""
VAULT_ENCRYPTION_KEY=""
CONTENT_ENCRYPTION_KEY=""

# Rate-limit global e dos fluxos sensíveis compartilhado entre instâncias. Sem eles,
# cai num contador em memória — aceitável em desenvolvimento, proibido em produção.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Alternativa compatível com provedores que expõem as credenciais Redis como KV.
# Configure apenas um dos dois pares; nunca misture uma URL de um par com token do outro.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
